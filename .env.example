# Wheel of Fortune — environment variables (example)
# Copy to .env.local (dev) or set in the Vercel project (prod). Do NOT commit real secrets.

# --- Supabase (required) ---
# The shared CRM/wheel project. Service-role key is server-only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# --- BwanaBet session token verification ---
# Phase 1 (default): decode-only. Set BWANA_VERIFY_SIGNATURE=1 + the HS256 secret
# to additionally require a valid signature (Phase 2).
BWANA_VERIFY_SIGNATURE=0
BWANA_JWT_SECRET=<hs256-secret-when-phase-2>

# --- Deposit-eligibility win gate (spec 2026-07-21) ---
# off = disabled (default); shadow = check + log only; enforce = gate the win.
DEPOSIT_GATE_MODE=off
# Sync timeout that drives the spin result (ms). Fail-closed past this.
DEPOSIT_CHECK_TIMEOUT_MS=2000
# Hard cap for the background call that records ground-truth eligibility (ms).
DEPOSIT_CHECK_BG_CAP_MS=10000
# BwanaBet API base (override only for staging).
BWANA_API_BASE=https://api.bwanabet.co.zm

# --- FCFS payout queue (spec 2026-08-12) ---
# positions = scattered winning slots (legacy, default); queue = every eligible
# spin wins until the K2,000 pot is empty, then silent losses until 06:00 CAT.
# ⚠️ queue mode REQUIRES DEPOSIT_GATE_MODE=enforce: with the gate off/shadow,
# every spinner counts as eligible and the first ~100 spins of the day win
# regardless of deposits.
WHEEL_PAYOUT_MODE=positions
# Qualifying-deposit window in wheel-days (deposit within the last N wheel-days
# OR today-so-far makes a spin eligible to win).
DEPOSIT_WINDOW_DAYS=7

# --- Telegram ---
# Win notifications go to TELEGRAM_CHAT_ID; error/telemetry alerts to TELEGRAM_ALERT_CHAT_ID.
TELEGRAM_BOT_TOKEN=<bot-token>
TELEGRAM_CHAT_ID=<win-notification-chat-id>
TELEGRAM_ALERT_CHAT_ID=<alert-dm-or-chat-id>

# --- Operational ---
# Kill-switch: set to 1 to make /api/spin and /api/spin-status return immediately
# without touching the DB (incident relief).
SPIN_MAINTENANCE=0
# Shared secret that gates test-mode spin traffic (x-wheel-test-token header).
WHEEL_TEST_TOKEN=<test-mode-secret>
# Shared secret for the daily digest cron (Vercel Cron -> /api/digest).
CRON_SECRET=<cron-secret>

# --- Deposit-gate alerting monitor (spec 2026-07-22) ---
# Reuses CRON_SECRET + TELEGRAM_ALERT_CHAT_ID. All thresholds are tunable.
GATE_MONITOR_WINDOW_MIN=15
GATE_MONITOR_MIN_SAMPLE=10
GATE_MONITOR_FAIL_RATE_SHADOW=0.30
GATE_MONITOR_FAIL_RATE_ENFORCE=0.20
GATE_MONITOR_P95_MS=1500
GATE_MONITOR_FALSE_DENIALS=3
GATE_MONITOR_COOLDOWN_MIN=30
